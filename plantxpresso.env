# PlantXpresso settings - read by the website (systemd), the nightly build (cron) and run.sh.
# Format: NAME=value, no spaces around "=", no quotes, no "export". Lines starting with # are ignored.

PLANTX_DATA_DIR=/vol/data/datasets/PlantXpresso
PLANTX_METADATA_TSV=/vol/data/datasets/PlantXpresso_metadata.tsv
PLANTX_METADATA_WEBSERVER_TSV=/vol/data/datasets/PlantXpresso_metadata_webserver.tsv
PLANTX_TISSUE_DIR=/vol/data/datasets/PlantXpresso_tissue_metadata
PLANTX_CACHE_DIR=/vol/data/plantxpresso_cache
PLANTX_JOBS_DIR=/vol/data/plantxpresso_jobs
PLANTX_LOGO=/vol/data/datasets/PlantXpresso_logo.png
PLANTX_DIAMOND=/vol/data/tools/diamond

# Only if the command-line download page shows a wrong web address:
#PLANTX_PUBLIC_URL=https://your-plantxpresso-link
