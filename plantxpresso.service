# systemd keeps PlantXpresso running: starts it at boot (after /vol/data is mounted)
# and restarts it if it crashes.
# Install:  sudo cp plantxpresso.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now plantxpresso
[Unit]
Description=PlantXpresso web server
Wants=network-online.target
After=network-online.target
# wait for the data volume; don't start without it
RequiresMountsFor=/vol/data

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/plantxpresso
EnvironmentFile=/home/ubuntu/plantxpresso/plantxpresso.env
# 4 worker processes = requests handled in parallel; 3838 = port the SimpleVM web service uses
ExecStart=/home/ubuntu/plantxpresso/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 3838 --workers 4 --forwarded-allow-ips=*
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
